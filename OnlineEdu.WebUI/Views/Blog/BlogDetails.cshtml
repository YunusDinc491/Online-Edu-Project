@model ResultBlogDto
@{
    ViewData["Title"] = "Blog Detayı";
    Layout = "~/Views/UILayout/Layout.cshtml";
}

<div class="slider-area ">
    <div class="slider-height2 d-flex align-items-center">
        <div class="container">
            <div class="row">
                <div class="col-xl-12">
                    <div class="hero-cap hero-cap2 text-center">
                        <h2>@Model.Title</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="blog_area single-post-area section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 posts-list">
                <div class="single-post">
                    <div class="feature-img">
                        <img class="img-fluid" src="@Model.ImageUrl" alt="">
                    </div>
                    <div class="blog_details">
                        <h2 style="color: #2d2d2d;">@Model.Title</h2>
                        <ul class="blog-info-link mt-3 mb-4">
                            <li><a href="#"><i class="fa fa-list"></i> @Model.blogCategory?.Name</a></li>
                        </ul>
                        <p class="excert">@Model.Content</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="blog_right_sidebar">
                    @await Component.InvokeAsync("_BlogCategoryList")
                    @await Component.InvokeAsync("_BlogRecentBlogs")
                    @await Component.InvokeAsync("_BlogSubscribe")
                </div>
            </div>
        </div>
    </div>
</section>
