<div class="count-down-area pt-90 pb-60 section-bg" data-background="/onlineedu-master/assets/img/gallery/section_bg01.png">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-12 col-md-12">
                <div class="count-down-wrapper">
                    <div class="row justify-content-between">
                        <div class="col-lg-3 col-md-6 col-sm-6">
                            <div class="single-counter text-center">
                                <span class="counter color-green">@ViewBag.blogCount</span>
                                <p class="color-green">+ Blog Sayısı</p>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-6">
                            <div class="single-counter text-center">
                                <span class="counter color-blue">@ViewBag.courseCount</span>
                                <p class="color-blue">+ Kurs Sayısı</p>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-6">
                            <div class="single-counter text-center">
                                <span class="counter color-green">@ViewBag.testimonialCount</span>
                                <p class="color-green">+ Referans Sayısı</p>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-6">
                            <div class="single-counter text-center">
                                <span class="counter color-red">@ViewBag.courseCategoryCount</span>
                                <p class="color-red">+ Kurs Kategorileri</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
